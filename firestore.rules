rules_version = '2';

// Regole di sicurezza di Firestore per la Lista Spesa.
// Da copiare in console.firebase.google.com → Firestore Database → Regole.
//
// Ogni famiglia è UN documento famiglie/{codice} che contiene membri, nomi,
// lista (voci) e prodotti personali. Solo i membri lo leggono e lo modificano.
service cloud.firestore {
  match /databases/{database}/documents {

    function membro(codice) {
      return request.auth != null &&
        request.auth.uid in get(/databases/$(database)/documents/famiglie/$(codice)).data.membri;
    }

    match /famiglie/{codice} {
      // Solo i membri leggono la lista (un codice inesistente si può controllare).
      allow get: if request.auth != null &&
        (resource == null || request.auth.uid in resource.data.membri);
      allow list: if false;

      // Creare una famiglia: all'inizio l'unico membro è chi la crea.
      allow create: if request.auth != null
        && request.resource.data.membri == [request.auth.uid];

      // I membri modificano tutto; chi ha il codice può solo aggiungere sé stesso.
      allow update: if request.auth != null && (
        request.auth.uid in resource.data.membri ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['membri', 'nomi']) &&
          request.resource.data.membri.toSet() ==
            resource.data.membri.toSet().union([request.auth.uid].toSet()) &&
          request.resource.data.nomi.diff(resource.data.nomi).affectedKeys().hasOnly([request.auth.uid])
        )
      );
      allow delete: if false;

      // Vecchia struttura (prima versione dell'app): serve solo per spostare
      // le liste esistenti nel documento famiglia.
      match /voci/{id} {
        allow read, delete: if membro(codice);
      }
      match /prodotti/{id} {
        allow read, delete: if membro(codice);
      }
    }
  }
}
